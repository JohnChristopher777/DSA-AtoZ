{
  "java.project.sourcePaths": ["src"],
  "java.project.outputPath": "bin",
  "java.configuration.updateBuildConfiguration": "automatic",
  "files.watcherExclude": {
    "**/bin/**": true
  },
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(java)$",
        "cmd": "java.project.import",
        "isAsync": false
      }
    ]
  }
}
